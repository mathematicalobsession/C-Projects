#include <stdio.h>

int main(void) {
    const double PI_VAL = 3.14159265;
// const is a variable that is constant and cant be changed, here its used to store pi 
// a double is used because its a floating point number that can store decimal values, here we use it to store pi
// so const double PI_VAL = 3.14159265; is a constant variable that stores the value of pi and cannot be changed
    double circleRadius; // double is used because its  a floating point number that can store decimal values, here we use it to store the radius of the circle
    double circleCircumference;
    double circleArea;

    printf(" Please enter the circumference of the circle: \n");
    // prompt the user then scan for user input 
    scanf("%lf", &circleCircumference); // note that "%lf uses & to store the user input into computer memory

    circleRadius = circleCircumference / (2 * PI_VAL); // formula to calculate the radius of a circle given its circumference
    circleArea = PI_VAL * (circleRadius * circleRadius); // formula to calculate the area of a circle given its radius

    printf("The Circle's Area is : %lf\n", circleArea);
    return 0;
}

